PORT=3000

# Postgres. As tabelas ficam no schema indicado em `?schema=`; sem ele, vão para `public`.
# Para dividir um Postgres com outro projeto, use um schema próprio e crie-o antes: CREATE SCHEMA platform;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform?schema=platform

# 32 bytes em base64 (ex.: openssl rand -base64 32). Cifra tokens do Moodle/Google. Obrigatorio.
SECRETS_KEY=

# Opcional: se definido, POST /usuarios exige o header x-signup-token com este valor.
SIGNUP_TOKEN=

# URL pública do serviço (atrás de proxy/TLS). Sem ela, é deduzida da requisição.
PUBLIC_URL=

# Origem do app web (ufba-app/web). Liga o modo web: CORS com cookie, cliente OAuth "ufba-web" e /authorize
# redirecionando para as telas do web. Dev: http://localhost:3001. Produção: https://ufba.app. Ver docs/WEB-API.md.
WEB_ORIGIN=

# Origem das telas de login e autorização (/sign-in, /authorize). Opcional: sem ela, usa WEB_ORIGIN.
# Dev: http://localhost:3002. Produção: https://auth.ufba.app.
AUTH_ORIGIN=

# Interface de escuta. Local: 127.0.0.1 (padrão). Railway/Docker: 0.0.0.0.
HOST=

# Google, app INTERNO da organização (login @ufba.br + Classroom das contas @ufba.br). Ver docs/MCP.md.
# Redirect cadastrado: <PUBLIC_URL>/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=ufba.br

# Google, app EXTERNO em teste (Classroom de convidados em gmail pessoal). Opcional.
# Redirect cadastrado: <PUBLIC_URL>/oauth/callback/classroom
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=

# Moodle (padrões: https://ava.ufba.br e web+ufba).
MOODLE_SITE_URL=
MOODLE_URL_SCHEME=

# Só desenvolvimento, sem Google configurado: senha da tela de /authorize.
OAUTH_AUTHORIZE_SECRET=
