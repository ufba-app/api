PORT=3000

# Postgres. As tabelas ficam no schema indicado em `?schema=`; sem ele, vão para `public`.
# Para dividir um Postgres com outro projeto, use um schema próprio e crie-o antes: CREATE SCHEMA platform;
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/platform?schema=platform

# 32 bytes em base64 (ex.: openssl rand -base64 32). Cifra tokens do Moodle/Google. Obrigatorio.
SECRETS_KEY=

# Opcional: se definido, POST /usuarios exige o header x-signup-token com este valor.
SIGNUP_TOKEN=
