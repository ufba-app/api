// DEPRECADA: permissões por pessoa, substituídas por `client_permissions` (por app). Não é mais lida nem gravada; some numa migração futura.
// Permissões por fonte: interruptores que a PESSOA liga pelo painel (ex.: deixar o Claude agendar sessões no SIASB).
// Sem linha = desligado (padrão). Desconectar a fonte apaga as linhas daquela fonte; `DELETE /me` apaga todas (cascade).
// Só guarda a chave e o valor: nada de dado clínico nem da fonte.
model UserPermission {
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "<fonte>.<ação>", ex.: "siasb.schedule_write". O conjunto válido é o enum PERMISSION_KEYS do contrato.
  key       String
  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([userId, key])
  @@map("user_permissions")
}
