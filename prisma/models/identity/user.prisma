model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String?
  // Preenchido pelo login do OAuth (tela de /authorize); usuários criados só por chave de API não têm.
  email     String?  @unique
  createdAt DateTime @default(now()) @map("created_at")

  apiKeys        ApiKey[]
  sourceAccounts SourceAccount[]
  profile        StudentProfile?
  transcript     Transcript?
  planItems      PlanItem[]
  enrollments    Enrollment[]
  oauthCodes     OAuthCode[]
  oauthTokens    OAuthToken[]
  sigaaCredentials SigaaCredential[]
  sigaaSessions    SigaaSession[]
  sigaaMasterSlots SigaaMasterSlot[]
  sigaaPairings    SigaaPairing[]
  sigaaVault       SigaaVault?
  academicConsent  AcademicConsent?
  academicImport   AcademicImport?
  academicImportLog AcademicImportLog[]
  sourceBindings   SourceBinding[]
  memoryUser       MemoryUser?
  ownedProjects    MemoryProject[]
  projectMembers   MemoryProjectMember[]
  teamRoles        UserTeamRole[]
  clientPermissions ClientPermission[]
  pushDevices      PushDevice[]
  notificationSettings NotificationSetting[]
  alertLog         AlertLog[]
  siasbDisciplines SiasbSyncedDiscipline[]
  siasbAttendances SiasbSyncedAttendance[]
  siasbSessions    SiasbSyncedSession[]
  siasbSyncState   SiasbSyncState?
  siasbWriteAudits SiasbWriteAudit[]

  @@map("users")
}
