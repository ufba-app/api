// Credencial do SIGAA guardada cifrada, uma por (usuário, cliente OAuth). Cifrada com AES-256-GCM usando uma chave
// derivada do segredo do cliente (K), que o servidor não guarda: só quem apresenta o token do cliente consegue abrir.
// Reaproveita o enum SourceAccountStatus (aqui só OK e REAUTH_NEEDED são usados).
model SigaaCredential {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String @map("client_id")
  login    String

  secretCiphertext String @map("secret_ciphertext")
  secretIv         String @map("secret_iv")
  secretAuthTag    String @map("secret_auth_tag")

  status    SourceAccountStatus @default(OK)
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([userId, clientId])
  @@map("sigaa_credentials")
}
