// Computador conectado da pessoa (uma chave `aim_` por computador). A chave NUNCA fica aqui: só o id da credencial no
// ai-memory e a prévia. `confirmedAt` nulo = a chave foi emitida mas o instalador ainda não confirmou a gravação; a
// varredura revoga o que não for confirmado em 10 minutos.
model MemoryComputer {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  os            String // windows | macos | linux
  credentialId  String    @map("credential_id")
  keyPreview    String?   @map("key_preview")
  agents        String[]
  clientVersion String?   @map("client_version")
  installMode   String?   @map("install_mode") // fresh | profile
  createdAt     DateTime  @default(now()) @map("created_at")
  confirmedAt   DateTime? @map("confirmed_at")
  lastSeenAt    DateTime? @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")

  memoryUser MemoryUser @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([confirmedAt, createdAt])
  @@map("memory_computers")
}

// Login de dispositivo (RFC 8628). Dura 10 minutos. Códigos e token curto só existem como hash SHA-256.
model DeviceAuthorization {
  deviceCodeHash String    @id @map("device_code_hash")
  userCodeHash   String    @unique @map("user_code_hash")
  clientId       String    @map("client_id")
  scope          String
  computerName   String?   @map("computer_name")
  os             String?
  requestIp      String?   @map("request_ip")
  // pending | approved | denied | issued (token curto entregue) | consumed (instalador confirmou a gravação)
  status         String
  userId         String?   @map("user_id") @db.Uuid
  intervalSec    Int       @default(5) @map("interval_sec")
  lastPolledAt   DateTime? @map("last_polled_at")
  pollCount      Int       @default(0) @map("poll_count")
  tokenHash      String?   @unique @map("token_hash")
  tokenExpiresAt DateTime? @map("token_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([expiresAt])
  @@index([requestIp, createdAt])
  @@map("device_authorizations")
}
